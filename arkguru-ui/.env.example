# Copy to `.env` (gitignored). Never commit a real password or API key.
# The wizard also loads the umbrella repo `.env` if present.

# Optional: override the umbrella checkout used to locate phase repos
# ARKGURU_ROOT=/path/to/arkguru-pdf-converter

# Optional: override individual checkouts (sibling or nested both work)
# PHASE1_REPO=/path/to/arkguru-pdf-extraction
# PHASE2_REPO=/path/to/arkguru-web-scraping
# PHASE3_REPO=/path/to/arkguru-rag-slm
# COMMON_REPO=/path/to/arkguru-common

# Same DSN the phase CLIs already read. Leave unset for file-mode RAG.
# PG_DSN=postgresql://rag:change-me@127.0.0.1:5433/rag
# PG_SSLMODE=require

# Optional Firecrawl key. Phase 2's crawl() is still the local httpx
# backend today; this is here so a later wiring can pick it up from env.
# FIRECRAWL_API_KEY=

# Optional Ollama host for generated (non-extractive) answers
# OLLAMA_HOST=http://127.0.0.1:11434
