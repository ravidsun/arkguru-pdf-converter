# Copy to `.env` (gitignored). Never commit a real password.
# ChunkStore reads PG_DSN. Change this value to switch hosts — no code changes.
# When unset, retrieve uses local JSONL.
#
# From arkguru-pdf-converter: bash scripts/detect_local_pg.sh

# Native local Postgres (port 5432)
# PG_DSN=postgresql://arkguru:arkguru@127.0.0.1:5432/arkguru
# PG_DSN=postgresql://rag:change-me@127.0.0.1:5432/rag

# Local Docker (arkguru-pdf-converter/compose.yaml) — host port 5433
# PG_DSN=postgresql://rag:change-me@127.0.0.1:5433/rag

# Hosted Supabase — session pooler (port 5432), not transaction mode (6543).
# Append sslmode=require (also applied automatically for remote hosts).
# PG_DSN=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Other hosted Postgres + pgvector (Neon, Crunchy, RDS, Aiven, …)
# Prefer a session/direct URI. Transaction poolers break named cursors.
# PG_DSN=postgresql://user:password@YOUR_HOST:5432/YOUR_DB?sslmode=require

# Optional: force sslmode when the URI omitted it (require | prefer | disable)
# PG_SSLMODE=require
